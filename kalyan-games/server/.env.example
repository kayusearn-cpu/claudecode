# ---- Kalyan Games server env ----
# On Railway, DATABASE_URL is injected automatically when you add a PostgreSQL plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/kalyan?schema=public"

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Shown in Google Authenticator when the admin scans the QR
ADMIN_TOTP_ISSUER="Kalyan Games"

# Seed admin credentials (used by `npm run seed`). Change the password before going live.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

NODE_ENV="development"
# PORT is provided by Railway automatically; only set it locally.
PORT="4000"
